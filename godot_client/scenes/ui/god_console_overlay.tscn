[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/god_console_overlay.gd" id="1_console"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_console"]
bg_color = Color(0.05, 0.06, 0.09, 0.94)
border_width_bottom = 2
border_color = Color(0.3, 0.7, 1, 0.85)
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

[node name="GodConsoleOverlay" type="CanvasLayer"]
layer = 30
script = ExtResource("1_console")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 340.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_console")

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.85, 1, 1)
theme_override_font_sizes/font_size = 14
text = "✦ GAIA DIVINE ENGINE CONSOLE [Toggle: ` / F1] ✦"

[node name="Spacer" type="Control" parent="Panel/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BtnClose" type="Button" parent="Panel/VBox/Header"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "✕"

[node name="LogText" type="RichTextLabel" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true

[node name="InputHBox" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PromptLabel" type="Label" parent="Panel/VBox/InputHBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 1, 0.5, 1)
text = "gaia>"

[node name="CmdInput" type="LineEdit" parent="Panel/VBox/InputHBox"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Enter divine command (e.g., status, pop, speed 20x, bless, save)..."
clear_button_enabled = true

[node name="BtnSend" type="Button" parent="Panel/VBox/InputHBox"]
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
text = "Run"
